.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/

data/synthetic/*
!data/synthetic/.gitkeep
results/*
!results/.gitkeep

# User-created scenarios/vessels (dashboard writes these at runtime;
# built-ins under configs/ are the only ones tracked in git)
configs/user_scenarios/
configs/user_vessels.yaml

# Only secrets are ignored here -- .streamlit/config.toml carries the app theme
# and must be committed, or Streamlit Cloud deploys an unthemed app.
.streamlit/secrets.toml
*.log
.DS_Store

# Harness-generated symlinks into .venv (not portable across machines)
.agents/
.claude/skills/
